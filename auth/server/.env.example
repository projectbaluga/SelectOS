# Copy this file to .env and replace every placeholder. Never commit .env.
SELECTOS_DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_HEX_SECRET
SELECTOS_AUTH_TOKEN_KEY=REPLACE_WITH_AT_LEAST_64_RANDOM_HEX_CHARACTERS
SELECTOS_ADMIN_USER=admin
SELECTOS_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
SELECTOS_AUTH_PORT=8088

# Bind to localhost by default; set this to the Debian server LAN IP for LAN access.
SELECTOS_BIND_IP=127.0.0.1
SELECTOS_DEVICE_ENROLLMENT_TOKEN=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
