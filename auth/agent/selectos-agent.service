[Unit]
Description=SelectOS LAN Device Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=selectos-agent
Group=selectos-agent
EnvironmentFile=/etc/selectos-agent.env
ExecStart=/usr/local/bin/selectos-agent
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/selectos-agent
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
