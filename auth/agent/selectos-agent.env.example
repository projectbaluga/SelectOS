# Copy to /etc/selectos-agent.env and chmod 600.
# Prefer an HTTPS URL with a trusted certificate.
SELECTOS_SERVER_URL=https://control-center.example.lan
SELECTOS_DEVICE_ID=replace-with-unique-device-id
SELECTOS_ENROLLMENT_TOKEN=replace-with-server-enrollment-secret
SELECTOS_STATE_FILE=/var/lib/selectos-agent/credentials.json
